# Variabilele de mediu CEMADO. Copiază în .env.local (local) sau pune-le în Vercel → Project Settings → Environment Variables.
# Niciuna nu e obligatorie local: fără ele, cererile se salvează în data/leads.db și emailul nu pleacă.

# ── Baza de date pentru cereri (obligatorie pe Vercel) ──
# Le pune automat integrarea Turso din Vercel Marketplace. Local, dacă le setezi, panoul citește cererile reale din Turso.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ── Emailul de notificare (Resend) ──
RESEND_API_KEY=
# Expeditorul trebuie să fie pe un domeniu verificat în Resend (DNS pe cemado.ro); până atunci: onboarding@resend.dev
LEAD_EMAIL_FROM=Site CEMADO <site@cemado.ro>
# Unde ajung toate cererile (mai multe adrese, separate prin virgulă)
LEAD_EMAIL_TO=
# Opțional: rutare pe linie de business (dacă e setată, înlocuiește LEAD_EMAIL_TO pentru acea linie)
LEAD_EMAIL_TELEFONIE=
LEAD_EMAIL_ASIGURARI=
LEAD_EMAIL_VACANTE=
LEAD_EMAIL_ENERGIE=
LEAD_EMAIL_FIRME=

# Adresa site-ului, pentru linkul „Deschide în panou” din email
SITE_URL=https://cemado.ro

# Panoul /manage merge doar pe localhost până există autentificare. 1 = deschis și pe Vercel (doar pentru test).
MANAGE_PUBLIC=
